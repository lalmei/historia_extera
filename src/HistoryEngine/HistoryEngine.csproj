<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net7.0 preserves the planned Vintage Story boundary recorded when it was chosen;
         revalidate it against the actual game version before Phase 3. net10.0 is what the
         CLI and tests run on locally. Multi-targeting catches a net10-only API in the engine. -->
    <TargetFrameworks>net7.0;net10.0</TargetFrameworks>

    <!-- Pinned to net7.0's default language version so both TFM builds compile
         identical semantics. Keeps "works on net10, breaks on net7" out of the
         core engine. -->
    <LangVersion>11.0</LangVersion>

    <RootNamespace>HistoryEngine</RootNamespace>
    <AssemblyName>HistoryEngine</AssemblyName>

    <!-- The engine is pure simulation: no UI, no Vintage Story, and deliberately
         no NuGet dependencies at all. Everything it needs (ZLibStream, System.Text.Json)
         is in the BCL on both targets. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Name corpora travel inside the assembly, so the artefact that eventually loads
         into Vintage Story carries its own training data and cannot be shipped
         half-configured. All eight families together are a few tens of kilobytes. -->
    <EmbeddedResource Include="Naming\Corpora\*.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests inspect deterministic scoring curves directly instead of inferring them through
         a whole simulated history. The production API remains intentionally small. -->
    <InternalsVisibleTo Include="HistoryEngine.Tests" />
  </ItemGroup>

</Project>

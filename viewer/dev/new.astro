---
import { NewWorld } from '../src/app/views/NewWorld';
import { WorldList } from '../src/app/views/WorldList';
import '../src/styles/global.css';

const viewer = import.meta.env.BASE_URL;
---

<!--
  The generator, on its own page.

  Everything here that can be static is static: the shell, the chrome and the prose are
  Astro, and the only island is the form, because the form is the only part that holds
  state. It is `client:load` rather than `client:only` — unlike the viewer app it has
  nothing to fetch before it can render, so the markup is prerendered and hydration only
  has to attach behaviour.

  A page rather than a route inside the viewer app, because it is not a view of a world:
  it needs no world loaded, which is exactly the case — an empty `public/worlds/` — where
  it is most useful. It hands its result to the viewer as `?world=`.

  It lives here rather than in `src/pages/` so that Astro's file router never sees it. The
  integration in world-generator.mjs injects it as `/new` under `astro dev` only, which is
  what keeps a built viewer free of both a page that cannot work and the island's code:
  a static import from `src/pages/` would have pulled the form into a shared client chunk
  even with nothing rendering it.
-->
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>New world — Historia Extera</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="mx-auto max-w-6xl px-4 py-6 md:px-10 md:py-10">
      <header
        class="flex flex-wrap items-baseline justify-between gap-3 border-b border-[var(--rule)] pb-4"
      >
        <a href={viewer} class="he-headline-md tracking-tight">
          Historia Extera
          <span class="he-label ml-3 inline align-middle">Legends</span>
        </a>
        <span class="he-label">Development only</span>
      </header>

      <main class="mt-8">
        <div class="he-label">Generator</div>
        <h1 class="he-headline mt-2">New world</h1>
        <p class="mt-3 max-w-prose text-[var(--ink-soft)]">
          Runs the engine over a seed and opens the history it writes. Pick a previous
          export from the list to rerun it with new parameters, through the current engine,
          or for more years.
        </p>

        <div class="mt-6">
          <NewWorld client:load />
        </div>

        <div class="mt-6">
          <WorldList client:load />
        </div>

        <p class="mt-6 text-sm">
          <a href={viewer} class="text-[var(--accent)] underline">Back to the viewer</a>
        </p>
      </main>
    </div>
  </body>
</html>
